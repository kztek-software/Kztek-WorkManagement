<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KztekWorkManagement.Mobile.ViewModels"
             xmlns:conv="using:KztekWorkManagement.Mobile.Common"
             x:Class="KztekWorkManagement.Mobile.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <ScrollViewer Background="{DynamicResource KzBackground}">
    <StackPanel Margin="16,16,16,80" Spacing="16">

      <!-- Project Banner -->
      <Border Background="{DynamicResource KzPrimary}" CornerRadius="16" Padding="18">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="DỰ ÁN HIỆN TẠI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource KzAccent}" />
            <TextBlock Text="{Binding CurrentProject.Name, FallbackValue='Đang tải dự án...'}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock Text="{Binding CurrentProject.Key, FallbackValue='KZ'}" FontSize="12" Foreground="#CBD5E1" />
          </StackPanel>
          <Button Grid.Column="1" Classes="kz-btn-accent" Command="{Binding GoToBoardCommand}" Padding="12,8" MinHeight="36" VerticalAlignment="Center">
            <TextBlock Text="Xem Bảng →" FontSize="12" />
          </Button>
        </Grid>
      </Border>

      <!-- KPI 4 Cards Grid -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4">
        
        <!-- TODO -->
        <Border Grid.Row="0" Grid.Column="0" Classes="kz-card" Margin="0,0,6,8" Background="#EFF6FF">
          <StackPanel Spacing="4">
            <TextBlock Text="Cần làm (TODO)" FontSize="12" FontWeight="Medium" Foreground="#1E40AF" />
            <TextBlock Text="{Binding TodoCount}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" />
          </StackPanel>
        </Border>

        <!-- IN PROGRESS -->
        <Border Grid.Row="0" Grid.Column="1" Classes="kz-card" Margin="6,0,0,8" Background="#FFF7ED">
          <StackPanel Spacing="4">
            <TextBlock Text="Đang xử lý" FontSize="12" FontWeight="Medium" Foreground="#C2410C" />
            <TextBlock Text="{Binding InProgressCount}" FontSize="24" FontWeight="Bold" Foreground="#9A3412" />
          </StackPanel>
        </Border>

        <!-- DONE -->
        <Border Grid.Row="1" Grid.Column="0" Classes="kz-card" Margin="0,0,6,0" Background="#ECFDF5">
          <StackPanel Spacing="4">
            <TextBlock Text="Đã hoàn thành" FontSize="12" FontWeight="Medium" Foreground="#047857" />
            <TextBlock Text="{Binding DoneCount}" FontSize="24" FontWeight="Bold" Foreground="#065F46" />
          </StackPanel>
        </Border>

        <!-- URGENT -->
        <Border Grid.Row="1" Grid.Column="1" Classes="kz-card" Margin="6,0,0,0" Background="#FEF2F2">
          <StackPanel Spacing="4">
            <TextBlock Text="Khẩn cấp / Cao" FontSize="12" FontWeight="Medium" Foreground="#B91C1C" />
            <TextBlock Text="{Binding UrgentCount}" FontSize="24" FontWeight="Bold" Foreground="#991B1B" />
          </StackPanel>
        </Border>

      </Grid>

      <!-- Urgent / High Priority Tasks -->
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Việc Ưu Tiên Cao &amp; Khẩn Cấp" FontSize="15" FontWeight="Bold" />
          <TextBlock Grid.Column="1" Text="Xem tất cả" FontSize="12" Foreground="{DynamicResource KzAccent}" FontWeight="SemiBold" />
        </Grid>

        <ItemsControl ItemsSource="{Binding UrgentTasks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="kz-card" Padding="14" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding TaskCode}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource KzAccent}" />
                      <Border Background="{Binding Priority, Converter={x:Static conv:PriorityToColorConverter.Instance}}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding Priority}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DueDateFormatted, StringFormat='Hạn chót: {0}'}" FontSize="11" Foreground="{DynamicResource KzTextMuted}" />
                  </StackPanel>

                  <Button Grid.Column="1" Classes="kz-btn-outline" 
                          Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).SelectTaskCommand}"
                          CommandParameter="{Binding}" Padding="8,6" MinHeight="32" VerticalAlignment="Center">
                    <TextBlock Text="Chi tiết" FontSize="11" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Tasks Assigned to Me -->
      <StackPanel Spacing="10" Margin="0,8,0,0">
        <TextBlock Text="Công việc của tôi" FontSize="15" FontWeight="Bold" />

        <ItemsControl ItemsSource="{Binding MyAssignedTasks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="kz-card" Padding="14" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding TaskCode}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource KzPrimary}" />
                      <Border Background="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
                  </StackPanel>

                  <Button Grid.Column="1" Classes="kz-btn-outline" 
                          Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).SelectTaskCommand}"
                          CommandParameter="{Binding}" Padding="8,6" MinHeight="32" VerticalAlignment="Center">
                    <TextBlock Text="Xem" FontSize="11" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
