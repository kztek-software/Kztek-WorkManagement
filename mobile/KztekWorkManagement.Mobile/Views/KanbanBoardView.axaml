<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KztekWorkManagement.Mobile.ViewModels"
             xmlns:conv="using:KztekWorkManagement.Mobile.Common"
             x:Class="KztekWorkManagement.Mobile.Views.KanbanBoardView"
             x:DataType="vm:KanbanBoardViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource KzBackground}">

    <!-- Top Action & Search Bar -->
    <Grid Grid.Row="0" Margin="16,12,16,8" ColumnDefinitions="*,Auto">
      <TextBox Grid.Column="0" Classes="kz-input" Text="{Binding SearchKeyword, Mode=TwoWay}" Watermark="🔍 Tìm kiếm công việc..." Margin="0,0,8,0" />
      <Button Grid.Column="1" Classes="kz-btn-accent" Command="{Binding CreateTaskCommand}" Padding="12,10" MinHeight="44">
        <TextBlock Text="+ Tạo việc" FontWeight="Bold" FontSize="13" />
      </Button>
    </Grid>

    <!-- Column Tabs Selector (Mobile Thumb Zone) -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,0,16,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        
        <Button Classes="kz-btn-outline" Command="{Binding SetStatusTabCommand}" CommandParameter="TODO" Padding="14,8" MinHeight="36">
          <TextBlock Text="Cần làm (TODO)" FontWeight="SemiBold" FontSize="12" />
        </Button>

        <Button Classes="kz-btn-outline" Command="{Binding SetStatusTabCommand}" CommandParameter="IN_PROGRESS" Padding="14,8" MinHeight="36">
          <TextBlock Text="Đang làm (IN PROGRESS)" FontWeight="SemiBold" FontSize="12" />
        </Button>

        <Button Classes="kz-btn-outline" Command="{Binding SetStatusTabCommand}" CommandParameter="IN_REVIEW" Padding="14,8" MinHeight="36">
          <TextBlock Text="Đang duyệt (REVIEW)" FontWeight="SemiBold" FontSize="12" />
        </Button>

        <Button Classes="kz-btn-outline" Command="{Binding SetStatusTabCommand}" CommandParameter="DONE" Padding="14,8" MinHeight="36">
          <TextBlock Text="Hoàn thành (DONE)" FontWeight="SemiBold" FontSize="12" />
        </Button>

        <Button Classes="kz-btn-outline" Command="{Binding SetStatusTabCommand}" CommandParameter="ALL" Padding="14,8" MinHeight="36">
          <TextBlock Text="Tất cả" FontWeight="SemiBold" FontSize="12" />
        </Button>

      </StackPanel>
    </ScrollViewer>

    <!-- Tasks List for Active Tab (Virtualized ListBox) -->
    <Grid Grid.Row="2" Margin="0,0,0,80">
      <!-- Empty State -->
      <Border Classes="kz-card" Margin="16,4,16,8" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Top"
              IsVisible="{Binding !DisplayedTasks.Count}">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center" />
          <TextBlock Text="Không có công việc nào trong danh mục này" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource KzTextSecondary}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Task Cards with Virtualizing ListBox -->
      <ListBox ItemsSource="{Binding DisplayedTasks}"
               Background="Transparent"
               BorderThickness="0"
               Padding="16,4,16,16"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
              <ControlTemplate>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Margin="{TemplateBinding Padding}"/>
              </ControlTemplate>
            </Setter>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="kz-card" Padding="14">
              <Grid RowDefinitions="Auto,Auto,Auto" Spacing="8">
                
                <!-- Card Header: Code, Priority, Status -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding TaskCode}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource KzAccent}" Margin="0,0,8,0" />
                  
                  <Border Grid.Column="1" Background="{Binding Priority, Converter={x:Static conv:PriorityToColorConverter.Instance}}" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding Priority}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                  </Border>

                  <Border Grid.Column="3" Background="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                  </Border>
                </Grid>

                <!-- Card Title -->
                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />

                <!-- Card Footer: Assignee, DueDate, Actions -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Background="{DynamicResource KzPrimaryLight}" Width="20" Height="20" CornerRadius="10">
                      <TextBlock Text="{Binding AssigneeName, Converter={x:Static conv:StringToInitialsConverter.Instance}}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding AssigneeName}" FontSize="12" Foreground="{DynamicResource KzTextSecondary}" VerticalAlignment="Center" />
                  </StackPanel>

                  <!-- Quick Advance Status Button -->
                  <Button Grid.Column="1" Classes="kz-btn-outline" 
                          Command="{Binding $parent[UserControl].((vm:KanbanBoardViewModel)DataContext).AdvanceStatusCommand}"
                          CommandParameter="{Binding}" Padding="8,4" MinHeight="30" Margin="0,0,6,0">
                    <TextBlock Text="Chuyển tiếp →" FontSize="11" />
                  </Button>

                  <!-- View Detail Button -->
                  <Button Grid.Column="2" Classes="kz-btn-primary" 
                          Command="{Binding $parent[UserControl].((vm:KanbanBoardViewModel)DataContext).SelectTaskCommand}"
                          CommandParameter="{Binding}" Padding="10,4" MinHeight="30">
                    <TextBlock Text="Xem" FontSize="11" />
                  </Button>
                </Grid>

              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

  </Grid>
</UserControl>
