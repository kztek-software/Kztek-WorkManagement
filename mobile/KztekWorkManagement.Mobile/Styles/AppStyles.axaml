<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Global TextBlock defaults -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial, sans-serif" />
    <Setter Property="Foreground" Value="{DynamicResource KzTextPrimary}" />
  </Style>

  <!-- Primary Action Button -->
  <Style Selector="Button.kz-btn-primary">
    <Setter Property="Background" Value="{DynamicResource KzPrimary}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="{DynamicResource KzRadiusMd}" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.kz-btn-primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource KzPrimaryLight}" />
  </Style>

  <!-- Accent Button -->
  <Style Selector="Button.kz-btn-accent">
    <Setter Property="Background" Value="{DynamicResource KzAccent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="{DynamicResource KzRadiusMd}" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.kz-btn-accent:pointerover">
    <Setter Property="Background" Value="{DynamicResource KzAccentHover}" />
  </Style>

  <!-- Outline Button -->
  <Style Selector="Button.kz-btn-outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource KzBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource KzTextPrimary}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="{DynamicResource KzRadiusMd}" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Mobile Input TextBox -->
  <Style Selector="TextBox.kz-input">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource KzBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KzRadiusMd}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Mobile Card Container -->
  <Style Selector="Border.kz-card">
    <Setter Property="Background" Value="{DynamicResource KzCardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KzBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KzRadiusMd}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #08000000" />
  </Style>

  <!-- Bottom Navigation Tab Button -->
  <Style Selector="Button.kz-nav-tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

</Styles>
